# BaceVector Environment Variables Template
# Copy this to .env.local and fill in your values

# Cloudflare Account
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# D1 Database IDs
D1_DATABASE_ID_PRODUCTION=your_production_db_id
D1_DATABASE_ID_STAGING=your_staging_db_id

# KV Namespace IDs
KV_NAMESPACE_ID_PRODUCTION=your_production_kv_id
KV_NAMESPACE_ID_STAGING=your_staging_kv_id

# R2 Bucket Names
R2_BUCKET_PRODUCTION=bacevector-docs-prod
R2_BUCKET_STAGING=bacevector-docs-staging

# Vectorize Index Names
VECTORIZE_INDEX_PRODUCTION=bacevector-docs
VECTORIZE_INDEX_STAGING=bacevector-docs-staging

# Stripe (for billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Plan Limits
BASE_PLAN_LIMIT_DOCS=100
BASE_PLAN_LIMIT_QUERIES=5000
PRO_PLAN_LIMIT_DOCS=500
PRO_PLAN_LIMIT_QUERIES=20000
OVERAGE_RATE_PER_QUERY=0.01

# Workers AI
EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
LLM_MODEL=@cf/meta/llama-3.1-8b-instruct

# Orchard Core
ORCHARD_DATABASE_PROVIDER=Sqlite
ORCHARD_DATABASE_CONNECTION=Data Source=App_Data/bacevector.db
ORCHARD_ADMIN_EMAIL=admin@example.com
ORCHARD_ADMIN_PASSWORD=change_me_in_production

# Application URLs
APP_URL_PRODUCTION=https://bacevector.com
APP_URL_STAGING=https://staging.bacevector.com
API_URL_PRODUCTION=https://api.bacevector.com
API_URL_STAGING=https://api-staging.bacevector.com

